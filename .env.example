# Copy to .env and fill in. NEVER commit .env.

# --- Discord bot ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Backend / ingestion ---
BACKEND_PORT=3000
INGEST_SHARED_SECRET=

# --- Bot: per-channel privacy config (JSON path) ---
# {"fallback": "public", "channels": {"<server_id>:<channel_id>": "private"}}
CHANNEL_CONFIG_PATH=channels.json
# Only channels whose name contains this ingest (live + backfill):
CHANNEL_NAME_FILTER=opportunities
# Backfill never reaches further back than this many days:
MAX_MESSAGE_AGE_DAYS=14

# --- LLM (extraction pipeline) ---
# The worker uses an OpenAI-compatible client (backend/worker.py), so any
# provider with an OpenAI-compatible endpoint works — e.g. for Anthropic set
# OPENAI_BASE_URL=https://api.anthropic.com/v1/ and use your Anthropic key.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Max LLM extraction calls per UTC day; unset or 0 = uncapped (worker warns).
LLM_DAILY_CALL_CAP=500

# --- Site revalidation (backend pings the site after publish/retract/purge/status) ---
SITE_URL=https://aisopportunities.com
REVALIDATE_SECRET=

# --- Airtable (canonical store) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Opportunities

# --- Email digest ---
RESEND_API_KEY=
# From-address for the digest (must be on a Resend-verified domain):
DIGEST_FROM_ADDRESS=digest@aisopportunities.com
# Backend URL the website's /api/subscribe proxies to (server-side only):
BACKEND_URL=http://localhost:3000
# Secret used to sign unsubscribe-link tokens (HMAC):
UNSUBSCRIBE_SECRET=
# Where the subscriber SQLite DB lives:
SUBSCRIBER_DB_PATH=subscribers.db

# --- Slack adapter (optional; leave blank to run Discord-only) ---
# Create the Slack app at api.slack.com/apps -> "From a manifest" using
# deploy/slack-app-manifest.json (replace <backend-host> first). The events-URL
# check fails until SLACK_SIGNING_SECRET is set on the backend: create the app,
# copy the credentials below from Basic Information, set them, then hit Retry
# on the Event Subscriptions page. All values below come from that app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Public URL of the OAuth callback, e.g. https://<your-backend>/slack/oauth/callback
SLACK_REDIRECT_URL=
# SQLite file for per-workspace bot tokens (on the Fly volume in production)
SLACK_TOKEN_DB_PATH=slack_tokens.db
