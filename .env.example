# Copy to .env and fill in. NEVER commit .env.

# --- Discord bot ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Backend / ingestion ---
BACKEND_PORT=3000
INGEST_SHARED_SECRET=

# --- Bot: per-channel privacy config (JSON path) ---
# {"fallback": "public", "channels": {"<server_id>:<channel_id>": "private"}}
CHANNEL_CONFIG_PATH=channels.json

# --- LLM (extraction pipeline) ---
ANTHROPIC_API_KEY=

# --- Airtable (canonical store) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Opportunities

# --- Email digest (later) ---
RESEND_API_KEY=
